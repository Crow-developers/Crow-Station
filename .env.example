# Copy to .env for local development: cp .env.example .env
# Local-only defaults. Real environments get their secrets from the deployment platform, never from git.

POSTGRES_DB=crow_station
POSTGRES_USER=crow
POSTGRES_PASSWORD=crow_dev_password
POSTGRES_PORT=5432

REDIS_PORT=6379

STORAGE_ACCESS_KEY=crow
STORAGE_SECRET_KEY=crow_dev_password
STORAGE_BUCKET=crow-station
STORAGE_PORT=9000
STORAGE_CONSOLE_PORT=9001

API_PORT=8080
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000

# Network binding. 127.0.0.1 keeps every port private to this machine.
# BIND_ADDRESS: PostgreSQL, Redis and storage. Keep it on 127.0.0.1.
# PUBLIC_BIND_ADDRESS: API and web. On a dev server, set it to the VPN address (for example the Tailscale IP).
BIND_ADDRESS=127.0.0.1
PUBLIC_BIND_ADDRESS=127.0.0.1

# Extra compose files. A dev server uses compose.yaml:compose.server.yaml (restart after reboot).
# COMPOSE_FILE=compose.yaml:compose.server.yaml
