{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build api",
      "program": "${workspaceFolder}/backend/src/CrowStation.Api/bin/Debug/net10.0/CrowStation.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/CrowStation.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:8080"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Now listening on: (https?://\\S+)",
        "uriFormat": "%s/scalar"
      }
    },
    {
      "name": "Web (Next.js)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/frontend/web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "env": { "API_BASE_URL": "http://localhost:8080" },
      "console": "integratedTerminal"
    }
  ],
  "compounds": [
    {
      "name": "API + Web",
      "configurations": ["API (.NET)", "Web (Next.js)"]
    }
  ]
}
