#!/usr/bin/env bash
# Enforces Conventional Commits: type(scope): subject  — https://www.conventionalcommits.org
set -euo pipefail

subject=$(head -n1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,100}$'

if [[ "$subject" =~ ^(Merge|Revert|fixup!|squash!) ]] || [[ "$subject" =~ $pattern ]]; then
  exit 0
fi

cat >&2 <<MSG
commit-msg: the first line must follow Conventional Commits, for example:
  feat(api): add course enrollment endpoint
  fix(web): keep RTL layout on small screens
Allowed types: feat fix docs style refactor perf test build ci chore revert
Got: $subject
MSG
exit 1
